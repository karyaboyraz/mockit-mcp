# ===== Backend selection =====
# 'cli'  → uses `claude` CLI in headless mode (uses your Claude Code subscription, $0 extra)
# 'api'  → uses Anthropic API directly (requires ANTHROPIC_API_KEY, ~$0.15-0.30/screen)
CLAUDE_BACKEND=cli

# ===== CLI backend settings =====
# Path to the claude CLI binary (default: 'claude' on PATH)
# CLAUDE_CLI_PATH=/usr/local/bin/claude
# Model override (default: whatever your CLI session uses)
# CLAUDE_CLI_MODEL=claude-opus-4-7
# Subprocess timeout
CLAUDE_CLI_TIMEOUT_MS=180000

# ===== API backend settings =====
# Required only if CLAUDE_BACKEND=api
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-opus-4-7

# ===== Storage =====
DESIGNS_DIR=./designs

# ===== MCP transport =====
# 'stdio'  → Claude Code direct (recommended for local dev)
# 'http'   → network access (recommended for remote/server deployment)
MCP_TRANSPORT=stdio
HTTP_PORT=7821
# Bind interface for HTTP transport. Defaults to loopback for safety.
# Use 0.0.0.0 ONLY if you also set MCP_HTTP_TOKEN (server refuses to start otherwise).
HTTP_HOST=127.0.0.1
# Bearer token required for non-loopback HTTP requests. Generate with: openssl rand -hex 32
# Clients must send: Authorization: Bearer <token>
# MCP_HTTP_TOKEN=

# ===== Render viewport (iPhone 15 Pro default) =====
VIEWPORT_WIDTH=390
VIEWPORT_HEIGHT=844
DEVICE_SCALE=2
